<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="family_ai.ChatFab">
        <button t-if="!state.open" type="button" class="o_fam_ai_fab" aria-label="Помощник" t-on-click="open">
            <span class="o_fam_ai_mark"/>
        </button>
        <t t-if="state.open">
            <div class="o_fam_ai_backdrop" t-on-click="close"/>
            <FamilyChatPanel close.bind="close"/>
        </t>
    </t>

    <t t-name="family_ai.ChatPanel">
        <div class="o_fam_ai_panel" t-ref="panel" role="dialog" aria-label="Помощник">
            <div class="o_fam_ai_head">
                <span class="o_fam_ai_head_mark"><span class="o_fam_ai_mark"/></span>
                <span class="o_fam_ai_title">Помощник</span>
                <button type="button" class="o_fam_ai_icon_btn" title="Новый разговор" aria-label="Новый разговор"
                        t-on-click="newChat" t-att-disabled="state.sending">
                    <i class="fa fa-refresh"/>
                </button>
                <button type="button" class="o_fam_ai_icon_btn" aria-label="Закрыть" t-on-click="props.close">
                    <i class="fa fa-times"/>
                </button>
            </div>

            <div class="o_fam_ai_list" t-ref="list">
                <div t-if="!state.configured" class="o_fam_ai_note">
                    На сервере не задан ключ ANTHROPIC_API_KEY, помощник пока не отвечает.
                </div>
                <t t-if="state.loaded and !state.messages.length">
                    <p class="o_fam_ai_note">Спроси про продукты дома, список покупок, питание, вес или деньги.</p>
                    <div class="o_fam_ai_examples">
                        <button t-foreach="examples" t-as="example" t-key="example" type="button"
                                class="o_fam_ai_example" t-on-click="() => this.send(example)">
                            <t t-esc="example"/>
                        </button>
                    </div>
                </t>
                <div t-foreach="state.messages" t-as="message" t-key="message_index"
                     t-attf-class="o_fam_ai_bubble o_fam_ai_bubble_{{ message.role }}">
                    <t t-esc="message.text"/>
                </div>
                <div t-if="state.sending" class="o_fam_ai_bubble o_fam_ai_bubble_assistant o_fam_ai_typing">
                    <span/><span/><span/>
                </div>
            </div>

            <div class="o_fam_ai_input">
                <textarea t-ref="input" rows="1" placeholder="Спроси что-нибудь…" enterkeyhint="send"
                          t-on-input="onInput" t-on-keydown="onKeydown"/>
                <button type="button" class="o_fam_ai_send" aria-label="Отправить"
                        t-att-disabled="state.sending or !state.text.trim()" t-on-click="() => this.send()">
                    <i class="fa fa-paper-plane"/>
                </button>
            </div>
        </div>
    </t>
</templates>
