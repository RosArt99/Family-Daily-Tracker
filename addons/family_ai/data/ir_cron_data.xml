<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Every hour; each job checks the person's local time and sends at most once
             (protein tip 19-21h, finance forecast on the 15th, month report on the 1st). -->
        <record id="ir_cron_family_ai_hourly" model="ir.cron">
            <field name="name">Assistant: scheduled messages (protein, finance)</field>
            <field name="model_id" ref="model_family_ai_jobs"/>
            <field name="state">code</field>
            <field name="code">model._cron_hourly()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(hours=1)).strftime('%Y-%m-%d %H:02:00')"/>
        </record>
    </data>
</odoo>
