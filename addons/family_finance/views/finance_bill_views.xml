<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_finance_bill_form" model="ir.ui.view">
        <field name="name">finance.bill.form</field>
        <field name="model">finance.bill</field>
        <field name="arch" type="xml">
            <form string="Grocery Bill">
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="store_id" options="{'no_open': True}" placeholder="Biedronka, Lidl, ..."/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="total_amount"/>
                            <field name="household_amount"/>
                            <field name="food_amount"/>
                            <field name="notes"/>
                        </group>
                    </group>
                    <group string="Receipt photos">
                        <field name="photo_ids" nolabel="1" mode="kanban">
                            <kanban>
                                <field name="image"/>
                                <templates>
                                    <t t-name="kanban-box">
                                        <div class="oe_kanban_global_click o_fin_photo_card">
                                            <img t-att-src="kanban_image('finance.photo', 'image', record.id.raw_value)" alt="Receipt"/>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_finance_bill_tree" model="ir.ui.view">
        <field name="name">finance.bill.tree</field>
        <field name="model">finance.bill</field>
        <field name="arch" type="xml">
            <tree string="Grocery Bills" default_order="date desc, id desc" js_class="finance_list">
                <field name="date"/>
                <field name="store_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="food_amount" sum="Food"/>
                <field name="household_amount" sum="Household"/>
                <field name="total_amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_finance_bill_kanban" model="ir.ui.view">
        <field name="name">finance.bill.kanban</field>
        <field name="model">finance.bill</field>
        <field name="arch" type="xml">
            <kanban quick_create="false" class="o_fin_kanban" js_class="finance_kanban">
                <field name="date"/>
                <field name="store_id"/>
                <field name="photo_count"/>
                <field name="user_id"/>
                <field name="total_amount"/>
                <field name="food_amount"/>
                <field name="household_amount"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click o_fin_card">
                            <span class="o_fin_card_icon o_fin_icon_bill"><i class="fa fa-shopping-basket" role="img" title="Bill"/></span>
                            <div class="o_fin_card_body">
                                <div class="o_fin_card_title">
                                    <field name="store_id"/>
                                    <span t-if="!record.store_id.raw_value" class="text-muted">Grocery bill</span>
                                </div>
                                <div class="o_fin_card_meta">
                                    <field name="date"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <span t-if="record.photo_count.raw_value" class="o_fin_photo_flag" title="Receipt photo attached"><i class="fa fa-camera"/> <t t-esc="record.photo_count.raw_value"/></span>
                                </div>
                                <div class="o_fin_chips">
                                    <span class="o_fin_chip o_fin_chip_food"><i class="fa fa-cutlery" title="Food"/> <field name="food_amount"/></span>
                                    <span t-if="record.household_amount.raw_value > 0" class="o_fin_chip o_fin_chip_house">
                                        <i class="fa fa-home" title="Household"/> <field name="household_amount"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_fin_card_amount"><field name="total_amount"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_finance_bill_graph" model="ir.ui.view">
        <field name="name">finance.bill.graph</field>
        <field name="model">finance.bill</field>
        <field name="arch" type="xml">
            <graph string="Grocery spending" type="bar" stacked="1">
                <field name="date" interval="month"/>
                <field name="food_amount" type="measure"/>
                <field name="household_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_finance_bill_search" model="ir.ui.view">
        <field name="name">finance.bill.search</field>
        <field name="model">finance.bill</field>
        <field name="arch" type="xml">
            <search string="Search Bills">
                <field name="store_id"/>
                <field name="user_id"/>
                <filter string="This month" name="filter_this_month"
                        domain="[('date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Mine" name="filter_mine" domain="[('user_id', '=', uid)]"/>
                <filter string="With household items" name="filter_household" domain="[('household_amount', '&gt;', 0)]"/>
                <group expand="0" string="Group By">
                    <filter string="Month" name="groupby_month" context="{'group_by': 'date:month'}"/>
                    <filter string="Store" name="groupby_store" context="{'group_by': 'store_id'}"/>
                    <filter string="Paid by" name="groupby_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_finance_bill" model="ir.actions.act_window">
        <field name="name">Groceries</field>
        <field name="res_model">finance.bill</field>
        <field name="view_mode">kanban,tree,graph,form</field>
        <field name="search_view_id" ref="view_finance_bill_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first grocery bill</p>
            <p>Enter just the bill's total, and how much of it was household items
               (cleaning supplies, toilet paper...). The rest is counted as food.</p>
        </field>
    </record>

</odoo>
