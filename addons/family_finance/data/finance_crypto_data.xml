<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="crypto_btc" model="finance.crypto.asset">
            <field name="name">Bitcoin</field>
            <field name="symbol">BTC</field>
            <field name="market">BTCUSDT</field>
            <field name="color">#F7931A</field>
            <field name="sequence">10</field>
        </record>
        <record id="crypto_eth" model="finance.crypto.asset">
            <field name="name">Ethereum</field>
            <field name="symbol">ETH</field>
            <field name="market">ETHUSDT</field>
            <field name="color">#7B3FE4</field>
            <field name="sequence">20</field>
        </record>
        <record id="crypto_xrp" model="finance.crypto.asset">
            <field name="name">XRP</field>
            <field name="symbol">XRP</field>
            <field name="market">XRPUSDT</field>
            <field name="color">#8E8E93</field>
            <field name="sequence">30</field>
        </record>

        <!-- Prices and daily history from Binance (the screen also refreshes stale prices itself). -->
        <record id="ir_cron_crypto_refresh" model="ir.cron">
            <field name="name">Finance: crypto prices from Binance</field>
            <field name="model_id" ref="model_finance_crypto_asset"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
        </record>
    </data>
</odoo>
