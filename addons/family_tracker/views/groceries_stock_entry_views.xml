<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_groceries_stock_entry_list" model="ir.ui.view">
        <field name="name">groceries.stock_entry.list</field>
        <field name="model">groceries.stock_entry</field>
        <field name="arch" type="xml">
            <!-- js_class swaps in groceries_stock_list.js's renderer: same fetched records
                 (respecting the active search/filters below), drawn as OFF-style cards with
                 same-product-and-status rows rolled into one summed quantity. Kanban (below)
                 stays the native per-item view, so Mark Consumed etc. still act one pack at
                 a time there. -->
            <tree string="Stock Entries" default_order="product_id, state" limit="500"
                  js_class="groceries_stock_list">
                <field name="product_id"/>
                <field name="state"/>
                <field name="quantity"/>
                <field name="uom_id"/>
                <field name="is_essential" column_invisible="1"/>
                <field name="nutriscore_grade" column_invisible="1"/>
                <field name="auto_restock" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_groceries_stock_entry_form" model="ir.ui.view">
        <field name="name">groceries.stock_entry.form</field>
        <field name="model">groceries.stock_entry</field>
        <field name="arch" type="xml">
            <form string="Stock Entry">
                <header>
                    <button name="action_mark_purchased" type="object" string="Mark Purchased"
                            class="oe_highlight" invisible="state != 'to_buy'"/>
                    <button name="action_mark_consumed" type="object" string="Mark Consumed / Discarded"
                            invisible="state != 'in_stock'"/>
                    <field name="state" widget="statusbar" statusbar_visible="to_buy,in_stock,consumed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_product" type="object" class="oe_stat_button" icon="fa-external-link">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Product card</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="purchase_date"/>
                            <field name="expiration_date"/>
                            <field name="consumed_date" invisible="state != 'consumed'"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_groceries_stock_entry_kanban" model="ir.ui.view">
        <field name="name">groceries.stock_entry.kanban</field>
        <field name="model">groceries.stock_entry</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" class="o_gs_kanban">
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="uom_id"/>
                <field name="expiration_date"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="is_essential"/>
                <field name="nutriscore_grade"/>
                <field name="auto_restock"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click o_gs_card o_gs_kanban_card">
                            <a type="object" name="action_open_product" role="button" class="text-reset flex-shrink-0"
                               title="Open product card">
                                <img class="o_gs_thumb"
                                     t-att-src="'/web/image/groceries.product/' + record.product_id.raw_value + '/image/128x128'"
                                     alt="Product photo"/>
                            </a>
                            <div class="o_gs_body">
                                <div class="o_gs_title_row">
                                    <a type="object" name="action_open_product" role="button" class="text-reset o_gs_name">
                                        <field name="product_id"/>
                                    </a>
                                    <i t-if="record.is_essential.raw_value" class="fa fa-star o_gs_essential"
                                       title="Essential product" role="img"/>
                                    <img t-if="record.nutriscore_grade.raw_value" class="o_gs_nutriscore"
                                         t-attf-src="/family_tracker/static/src/img/nutriscore_{{record.nutriscore_grade.raw_value}}.svg"
                                         alt="Nutri-Score"/>
                                    <!-- Two elements swapped by t-if, not one with a ternary t-att-class:
                                         kanban's template compiler (unlike a real Owl component) doesn't
                                         evaluate a ternary there reliably - every card ended up with the
                                         "on" class regardless of its actual value. Same proven pattern as
                                         the Mark Purchased/Mark Consumed pair below. -->
                                    <a t-if="!record.auto_restock.raw_value" role="button" type="object"
                                       name="action_toggle_product_restock" class="o_groceries_restock_chip"
                                       title="Re-Stock is off: click to turn on">
                                        <i class="fa fa-refresh"/>
                                    </a>
                                    <a t-if="record.auto_restock.raw_value" role="button" type="object"
                                       name="action_toggle_product_restock"
                                       class="o_groceries_restock_chip o_gs_restock_on"
                                       title="Re-Stock is on: a consumed pack goes straight back to To Buy">
                                        <i class="fa fa-refresh"/>
                                    </a>
                                </div>
                                <div class="o_gs_meta_row">
                                    <span class="o_gs_qty">
                                        <b><field name="quantity"/></b> <field name="uom_id"/>
                                    </span>
                                    <span t-if="record.expiration_date.raw_value" class="o_gs_exp">
                                        Exp <field name="expiration_date"/>
                                    </span>
                                </div>
                                <div class="o_gs_bottom_row">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <a t-if="record.state.raw_value == 'to_buy'" role="button"
                                       type="object" name="action_mark_purchased" class="o_gs_action">
                                        Mark Purchased
                                    </a>
                                    <a t-if="record.state.raw_value == 'in_stock'" role="button"
                                       type="object" name="action_mark_consumed" class="o_gs_action o_gs_action_secondary">
                                        Mark Consumed
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_groceries_stock_entry_search" model="ir.ui.view">
        <field name="name">groceries.stock_entry.search</field>
        <field name="model">groceries.stock_entry</field>
        <field name="arch" type="xml">
            <search string="Search Stock Entries">
                <field name="product_id"/>
                <field name="user_id"/>
                <filter string="To Buy" name="filter_to_buy" domain="[('state', '=', 'to_buy')]"/>
                <filter string="In Stock" name="filter_in_stock" domain="[('state', '=', 'in_stock')]"/>
                <filter string="Consumed" name="filter_consumed" domain="[('state', '=', 'consumed')]"/>
                <separator/>
                <filter string="My Entries" name="filter_my_entries" domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                    <filter string="Added By" name="groupby_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- The combined, unfiltered view (all three states together) - kept for completeness,
         not linked from any menu since the landing page (family_tracker.stock_landing,
         groceries_stock_landing.js) is the entry point now; its three buttons open the
         category-scoped actions below instead. -->
    <record id="action_groceries_stock_entry" model="ir.actions.act_window">
        <field name="name">Shopping List &amp; Stock</field>
        <field name="res_model">groceries.stock_entry</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_groceries_stock_entry_search"/>
        <field name="context">{'search_default_filter_to_buy': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add something to the shopping list
            </p>
            <p>
                Track items from "to buy" through "in stock" to "consumed / discarded"
                by scanning the same product's barcode at each stage.
            </p>
        </field>
    </record>

    <!-- Same model, same Kanban (now naturally down to one column via
         GroceriesStockEntry._read_group_state) and same custom List - just pre-filtered to
         one lifecycle stage, opened from the landing page's three big buttons. -->
    <record id="action_groceries_stock_to_buy" model="ir.actions.act_window">
        <field name="name">To Buy</field>
        <field name="res_model">groceries.stock_entry</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_groceries_stock_entry_search"/>
        <field name="domain">[('state', '=', 'to_buy')]</field>
        <field name="context">{'default_state': 'to_buy'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing on the shopping list</p>
            <p>Scan a barcode with "Add to shopping list" to put something here.</p>
        </field>
    </record>

    <record id="action_groceries_stock_in_stock" model="ir.actions.act_window">
        <field name="name">In Stock</field>
        <field name="res_model">groceries.stock_entry</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_groceries_stock_entry_search"/>
        <field name="domain">[('state', '=', 'in_stock')]</field>
        <field name="context">{'default_state': 'in_stock'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing in stock yet</p>
            <p>Scan a barcode at checkout ("Mark Purchased") to move it here.</p>
        </field>
    </record>

    <record id="action_groceries_stock_consumed" model="ir.actions.act_window">
        <field name="name">Consumed / Discarded</field>
        <field name="res_model">groceries.stock_entry</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_groceries_stock_entry_search"/>
        <field name="domain">[('state', '=', 'consumed')]</field>
        <field name="context">{'default_state': 'consumed'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing consumed or discarded yet</p>
            <p>Scan a pack's barcode once it's finished or thrown away to log it here.</p>
        </field>
    </record>

    <record id="action_groceries_stock_landing" model="ir.actions.client">
        <field name="name">Shopping List &amp; Stock</field>
        <field name="tag">family_tracker.stock_landing</field>
    </record>

    <!-- Bulk actions: select multiple rows in the list view (checkboxes) and apply
         via the "Action" (gear) menu, instead of dragging cards one by one in kanban. -->
    <record id="action_server_groceries_bulk_mark_purchased" model="ir.actions.server">
        <field name="name">Mark Purchased</field>
        <field name="model_id" ref="model_groceries_stock_entry"/>
        <field name="binding_model_id" ref="model_groceries_stock_entry"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.filtered(lambda r: r.state == 'to_buy').action_mark_purchased()</field>
    </record>

    <record id="action_server_groceries_bulk_mark_consumed" model="ir.actions.server">
        <field name="name">Mark Consumed / Discarded</field>
        <field name="model_id" ref="model_groceries_stock_entry"/>
        <field name="binding_model_id" ref="model_groceries_stock_entry"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.filtered(lambda r: r.state == 'in_stock').action_mark_consumed()</field>
    </record>

    <record id="action_server_groceries_bulk_refresh_off" model="ir.actions.server">
        <field name="name">Refresh products from Open Food Facts</field>
        <field name="model_id" ref="model_groceries_stock_entry"/>
        <field name="binding_model_id" ref="model_groceries_stock_entry"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.mapped('product_id').action_refresh_from_off_bulk()</field>
    </record>

</odoo>
