<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Triggered right after a scan (see groceries.product._trigger_photo_fetch);
         the schedule below is only the retry safety net for failed downloads. -->
    <record id="ir_cron_fetch_product_images" model="ir.cron">
        <field name="name">Groceries: fetch product photos from Open Food Facts</field>
        <field name="model_id" ref="model_groceries_product"/>
        <field name="state">code</field>
        <field name="code">model._cron_fetch_missing_images()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
    </record>

    <data noupdate="1">
        <!-- 03:00 Warsaw time (01:00 UTC in summer, 02:00 UTC in winter) -->
        <record id="ir_cron_refresh_unresolved_products" model="ir.cron">
            <field name="name">Groceries: re-check unresolved products on Open Food Facts</field>
            <field name="model_id" ref="model_groceries_product"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_unresolved_products()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 01:00:00')"/>
        </record>
    </data>

</odoo>
