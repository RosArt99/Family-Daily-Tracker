<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ============================== New / edit recipe ============================== -->
    <t t-name="family_gym.RecipeFormDialog">
        <Dialog title="title" size="'lg'" contentClass="'o_gym_recipe_dialog'">
            <div class="o_gym_ui_form">
                <div t-if="state.error" class="o_gym_ui_error" t-esc="state.error"/>

                <div class="o_gym_ui_hero">
                    <span class="o_gym_ui_hero_icon"><i class="fa fa-cutlery" role="img"/></span>
                    <div class="o_gym_ui_hero_text">
                        <label for="o_gym_ui_hero_input">Recipe name</label>
                        <input id="o_gym_ui_hero_input" type="text" class="o_gym_ui_hero_input"
                               placeholder="e.g. Chicken with rice"
                               t-model="state.name" autocomplete="off"/>
                    </div>
                </div>

                <div class="o_gym_ui_card">
                    <div class="o_gym_ui_label">Description</div>
                    <textarea class="o_gym_ui_textarea" rows="3"
                              placeholder="How it is cooked, tips, what it goes with..."
                              t-model="state.description"/>
                </div>

                <div class="o_gym_ui_card">
                    <div class="o_gym_ui_label">Category</div>
                    <div class="o_gym_cat_pick">
                        <button type="button" class="o_gym_cat_chip" t-att-class="{ o_active: !state.categoryId }"
                                t-on-click="() => state.categoryId = false">None</button>
                        <button t-foreach="state.categories" t-as="cat" t-key="cat.id" type="button" class="o_gym_cat_chip"
                                t-att-class="{ o_active: state.categoryId == cat.id }"
                                t-on-click="() => state.categoryId = cat.id" t-esc="cat.name"/>
                    </div>
                    <div class="o_gym_cat_new">
                        <input type="text" class="o_gym_ui_input" placeholder="New category..." autocomplete="off"
                               t-model="state.newCategory" t-on-keydown="(ev) => ev.key === 'Enter' and this.addCategory()"/>
                        <button type="button" t-on-click="addCategory"><i class="fa fa-plus" role="img" title="Add"/></button>
                    </div>
                </div>

                <div class="o_gym_ui_card">
                    <div class="o_gym_ui_label">Number of servings</div>
                    <div class="o_gym_ui_stepper">
                        <button type="button" class="o_gym_ui_step" aria-label="Fewer servings"
                                t-on-click="() => this.stepServings(-1)"><i class="fa fa-minus"/></button>
                        <input type="text" inputmode="numeric" pattern="[0-9]*" class="o_gym_ui_number"
                               t-att-value="state.servings" t-on-input="onServingsInput" t-on-blur="onServingsBlur"/>
                        <button type="button" class="o_gym_ui_step" aria-label="More servings"
                                t-on-click="() => this.stepServings(1)"><i class="fa fa-plus"/></button>
                    </div>
                </div>

                <div class="o_gym_ui_card">
                    <div class="o_gym_ui_label">Weight of the finished dish</div>
                    <div class="o_gym_recipe_weight o_gym_recipe_cooked">
                        <input type="text" inputmode="decimal" t-att-value="state.cookedWeight"
                               t-on-input="onCookedInput" aria-label="Weight of the finished dish in grams"
                               t-att-placeholder="fmt(totals.weight)"/>
                        <span>g</span>
                    </div>
                    <div class="o_gym_ui_hint">
                        Weigh the whole pan after cooking (cooking changes the weight). Leave empty to use
                        the ingredients' weight (<t t-esc="fmt(totals.weight)"/> g).
                    </div>
                </div>

                <div class="o_gym_ui_card">
                    <div class="o_gym_ui_label">Ingredients</div>
                    <div t-if="!state.ingredients.length" class="o_gym_ui_empty">
                        Add food from your Groceries - or another recipe - and set how much of it goes in.
                    </div>
                    <div t-foreach="state.ingredients" t-as="line" t-key="line.key" class="o_gym_recipe_ing">
                        <img t-if="line.product_id" class="o_gym_recipe_ing_img" alt=""
                             t-att-src="'/web/image/groceries.product/' + line.product_id + '/image/96x96'"/>
                        <span t-else="" class="o_gym_recipe_ing_img o_sub" title="Recipe"><i class="fa fa-cutlery" role="img"/></span>
                        <div class="o_gym_recipe_ing_info">
                            <div class="o_gym_recipe_ing_name" t-esc="line.name"/>
                            <div class="o_gym_recipe_ing_kcal">
                                <t t-esc="lineKcal(line)"/> kcal<t t-if="line.sub_recipe_id"> · recipe</t>
                                <span t-if="line.missing" class="o_gym_recipe_warn">
                                    <i class="fa fa-exclamation-triangle"/> no nutrition data
                                </span>
                            </div>
                        </div>
                        <div class="o_gym_recipe_weight">
                            <input type="text" inputmode="decimal" t-att-value="line.quantity"
                                   t-on-input="(ev) => this.onWeightInput(ev, line)" aria-label="Weight in grams"/>
                            <span>g</span>
                        </div>
                        <button type="button" class="o_gym_recipe_remove" aria-label="Remove"
                                t-on-click="() => this.removeIngredient(line)"><i class="fa fa-times"/></button>
                    </div>
                    <div class="o_gym_ui_add_row">
                        <button type="button" class="o_gym_ui_add" t-on-click="addIngredients">
                            <i class="fa fa-plus"/> Add ingredient
                        </button>
                        <button type="button" class="o_gym_ui_add" t-on-click="addRecipe">
                            <i class="fa fa-plus"/> Add recipe
                        </button>
                    </div>
                </div>

                <div class="o_gym_ui_card o_gym_recipe_nutrition" t-if="state.ingredients.length">
                    <div class="o_gym_ui_label">Per serving</div>
                    <div class="o_gym_ui_bignumber"><b t-esc="perServing.calories"/> <span>kcal</span></div>
                    <div class="o_gym_ui_hint o_gym_serving_weight">
                        <b><t t-esc="fmt(servingWeight)"/> g</b> per serving
                        · <t t-esc="fmt(kcalPer100)"/> kcal / 100 g
                    </div>
                    <div class="o_gym_ui_split">
                        <div t-foreach="macroSplit" t-as="macro" t-key="macro.key" class="o_gym_ui_split_part"
                             t-att-style="'width:' + macro.percent + '%; background:' + macro.color"/>
                    </div>
                    <div class="o_gym_ui_legend">
                        <span t-foreach="macroSplit" t-as="macro" t-key="macro.key">
                            <i class="o_gym_ui_dot" t-att-style="'background:' + macro.color"/>
                            <t t-esc="macro.label"/> <b><t t-esc="macro.grams"/> g</b>
                        </span>
                    </div>
                    <div class="o_gym_ui_footnote">
                        Whole recipe: <b><t t-esc="fmt(totals.calories)"/> kcal</b>
                        · <t t-esc="fmt(dishWeight)"/> g
                    </div>
                </div>

            </div>

            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary o_gym_recipe_save" t-att-disabled="state.saving"
                        t-on-click="save">Save recipe</button>
                <button type="button" class="btn btn-secondary" t-on-click="() => this.props.close()">Cancel</button>
            </t>
        </Dialog>
    </t>

    <!-- ===================== file a dish under a category ===================== -->
    <t t-name="family_gym.RecipeCategoryDialog">
        <Dialog title="props.recipe.name" size="'md'" contentClass="'o_gym_addfood_dialog'" footer="false">
            <div class="o_gym_addfood">
                <div t-if="state.error" class="o_gym_ui_error" t-esc="state.error"/>
                <div class="o_gym_ui_label">Category</div>
                <div class="o_gym_cat_pick">
                    <button t-foreach="state.categories" t-as="cat" type="button" class="o_gym_cat_chip"
                            t-key="cat.id" t-att-class="{ o_active: props.recipe.category_id == cat.id }"
                            t-on-click="() => this.choose(cat.id)" t-esc="cat.name"/>
                    <button type="button" class="o_gym_cat_chip o_none" t-att-class="{ o_active: !props.recipe.category_id }"
                            t-on-click="() => this.choose(false)">No category</button>
                </div>
                <div class="o_gym_cat_new">
                    <input type="text" class="o_gym_ui_input" placeholder="New category..." autocomplete="off"
                           t-model="state.newName" t-on-keydown="(ev) => ev.key === 'Enter' and this.addAndChoose()"/>
                    <button type="button" t-on-click="addAndChoose"><i class="fa fa-plus" role="img" title="Add"/></button>
                </div>
            </div>
        </Dialog>
    </t>

    <!-- ===================== manage categories ===================== -->
    <t t-name="family_gym.CategoriesDialog">
        <Dialog title="'Categories'" size="'md'" contentClass="'o_gym_addfood_dialog'" footer="false">
            <div class="o_gym_addfood">
                <div t-if="state.error" class="o_gym_ui_error" t-esc="state.error"/>
                <div t-foreach="state.categories" t-as="cat" t-key="cat.id" class="o_gym_cat_row">
                    <input type="text" class="o_gym_ui_input" t-att-value="cat.name" autocomplete="off"
                           t-on-change="(ev) => this.rename(cat, ev)"/>
                    <span class="o_gym_cat_count"><t t-esc="cat.count"/></span>
                    <button type="button" aria-label="Delete category" t-on-click="() => this.remove(cat)"><i class="fa fa-trash-o" role="img" title="Delete"/></button>
                </div>
                <div class="o_gym_cat_new">
                    <input type="text" class="o_gym_ui_input" placeholder="New category..." autocomplete="off"
                           t-model="state.newName" t-on-keydown="(ev) => ev.key === 'Enter' and this.add()"/>
                    <button type="button" t-on-click="add"><i class="fa fa-plus" role="img" title="Add"/></button>
                </div>
                <div class="o_gym_ui_hint">Rename by editing the name. Deleting a category keeps its dishes.</div>
            </div>
        </Dialog>
    </t>

    <!-- ===================== a recipe as an ingredient of another recipe ===================== -->
    <t t-name="family_gym.RecipePickerDialog">
        <Dialog title="'Choose a recipe'" size="'md'" contentClass="'o_gym_addfood_dialog'" footer="false">
            <div class="o_gym_addfood o_gym_addfood_saved">
                <input type="search" class="o_gym_addfood_search" placeholder="Search saved food..."
                       t-att-value="state.search" t-on-input="onSearchInput"/>
                <div t-if="!state.recipes.length" class="o_gym_addfood_empty">
                    <t t-if="state.search">Nothing matches your search.</t>
                    <t t-else="">No other recipes yet.</t>
                </div>
                <div t-foreach="state.recipes" t-as="recipe" t-key="recipe.id" class="o_gym_saved_card">
                    <button type="button" class="o_gym_saved_main" t-on-click="() => this.pick(recipe)">
                        <span class="o_gym_saved_name" t-esc="recipe.name"/>
                        <span class="o_gym_saved_meta">
                            <t t-esc="fmt(recipe.total_weight_g)"/> g in total
                            <t t-if="!recipe.mine"> · by <t t-esc="recipe.owner"/></t>
                        </span>
                        <span class="o_gym_saved_macros">
                            <b><t t-esc="fmt(recipe.per_100g.calories)"/> kcal</b> per 100 g
                        </span>
                    </button>
                </div>
            </div>
        </Dialog>
    </t>

    <!-- ===================== "+" on a meal: where does the food come from ===================== -->
    <t t-name="family_gym.AddFoodDialog">
        <Dialog title="title" size="'md'" contentClass="'o_gym_addfood_dialog'" footer="false">
            <div class="o_gym_addfood">

                <button t-if="canGoBack" type="button" class="o_gym_addfood_back"
                        t-on-click="back"><i class="fa fa-chevron-left"/> Back</button>

                <!-- 1. the two sources -->
                <div t-if="state.step === 'menu'" class="o_gym_addfood_menu">
                    <button type="button" class="o_gym_addfood_tile" t-on-click="pantry">
                        <span class="o_gym_addfood_tile_icon"><i class="fa fa-shopping-basket" role="img"/></span>
                        <span class="o_gym_addfood_tile_text">
                            <b>From Groceries</b>
                            <span>Food you have in stock</span>
                        </span>
                        <i class="fa fa-chevron-right"/>
                    </button>
                    <button type="button" class="o_gym_addfood_tile" t-on-click="restaurants">
                        <span class="o_gym_addfood_tile_icon o_rest"><i class="fa fa-shopping-bag" role="img"/></span>
                        <span class="o_gym_addfood_tile_text">
                            <b>Restaurants</b>
                            <span>McDonald's, KFC, Burger King...</span>
                        </span>
                        <i class="fa fa-chevron-right"/>
                    </button>
                    <button type="button" class="o_gym_addfood_tile" t-on-click="openSaved">
                        <span class="o_gym_addfood_tile_icon o_saved"><i class="fa fa-bookmark" role="img"/></span>
                        <span class="o_gym_addfood_tile_text">
                            <b>My Saved Food</b>
                            <span>Your recipes and saved meals</span>
                        </span>
                        <i class="fa fa-chevron-right"/>
                    </button>

                    <!-- what was eaten lately, from any source: tap to add it again -->
                    <t t-if="state.history.length">
                        <div class="o_gym_hist_title">History</div>
                        <button t-foreach="state.history" t-as="item" t-key="item_index" type="button"
                                class="o_gym_hist_row" t-on-click="() => this.repeat(item)">
                            <span class="o_gym_hist_main">
                                <span class="o_gym_hist_name" t-esc="item.name"/>
                                <span class="o_gym_hist_meta">
                                    <t t-if="item.amount_label"><t t-esc="item.amount_label"/> · </t>
                                    P <t t-esc="item.protein"/> · C <t t-esc="item.carbs"/> · F <t t-esc="item.fat"/>
                                </span>
                            </span>
                            <span class="o_gym_hist_kcal"><t t-esc="item.calories"/> kcal</span>
                            <i class="fa fa-plus o_gym_hist_add" role="img"/>
                        </button>
                    </t>
                </div>

                <!-- 2. saved recipes -->
                <div t-if="state.step === 'saved'" class="o_gym_addfood_saved">
                    <button type="button" class="o_gym_addfood_new" t-on-click="newRecipe">
                        <i class="fa fa-plus"/> Add New Recipe
                    </button>
                    <input type="search" class="o_gym_addfood_search" placeholder="Search saved food..."
                           t-att-value="state.search" t-on-input="onSearchInput"/>
                    <!-- category filter: all / not filed yet / one of the shelves -->
                    <div class="o_gym_cat_chips">
                        <button type="button" class="o_gym_cat_chip" t-att-class="{ o_active: state.category == 'all' }"
                                t-on-click="() => this.setCategory('all')">All <b t-esc="state.total"/></button>
                        <button t-if="state.uncategorized" type="button" class="o_gym_cat_chip o_none"
                                t-att-class="{ o_active: state.category == 'none' }"
                                t-on-click="() => this.setCategory('none')">Not filed <b t-esc="state.uncategorized"/></button>
                        <button t-foreach="state.categories" t-as="cat" t-key="cat.id" type="button" class="o_gym_cat_chip"
                                t-att-class="{ o_active: state.category == cat.id }"
                                t-on-click="() => this.setCategory(cat.id)"><t t-esc="cat.name"/> <b t-esc="cat.count"/></button>
                        <button type="button" class="o_gym_cat_chip o_manage" aria-label="Manage categories" title="Manage categories"
                                t-on-click="manageCategories"><i class="fa fa-cog" role="img"/></button>
                    </div>
                    <div t-if="!hasRecipes" class="o_gym_addfood_empty">
                        <t t-if="state.search">Nothing matches your search.</t>
                        <t t-elif="state.category != 'all'">No dishes here yet.</t>
                        <t t-else="">No saved food yet. Add your first recipe!</t>
                    </div>
                    <t t-foreach="recipeGroups" t-as="group" t-key="group.key">
                        <div t-if="group.title" class="o_gym_cat_title" t-esc="group.title"/>
                        <div t-foreach="group.recipes" t-as="recipe" t-key="recipe.id" class="o_gym_saved_card">
                            <button type="button" class="o_gym_saved_main" t-on-click="() => this.pick(recipe)">
                                <span class="o_gym_saved_name" t-esc="recipe.name"/>
                                <span class="o_gym_saved_meta">
                                    <t t-esc="recipe.servings"/> serving<t t-if="recipe.servings !== 1">s</t>
                                    · <t t-esc="recipe.ingredient_count"/> ingredient<t t-if="recipe.ingredient_count !== 1">s</t>
                                    <t t-if="!recipe.mine"> · by <t t-esc="recipe.owner"/></t>
                                </span>
                                <span class="o_gym_saved_macros">
                                    <b><t t-esc="fmt(recipe.per_serving.calories)"/> kcal</b> per serving
                                    (<t t-esc="fmt(recipe.serving_weight_g)"/> g)
                                    · P <t t-esc="fmt(recipe.per_serving.protein)"/>
                                    · C <t t-esc="fmt(recipe.per_serving.carbs)"/>
                                    · F <t t-esc="fmt(recipe.per_serving.fat)"/>
                                </span>
                            </button>
                            <span class="o_gym_saved_actions">
                                <button type="button" t-att-class="{ o_filed: recipe.category_id }"
                                        t-att-title="recipe.category || 'Choose a category'" aria-label="Choose a category"
                                        t-on-click="() => this.fileRecipe(recipe)"><i class="fa fa-tag"/></button>
                                <button t-if="recipe.mine" type="button" aria-label="Edit recipe" t-on-click="() => this.editRecipe(recipe)"><i class="fa fa-pencil"/></button>
                                <button t-if="recipe.mine" type="button" aria-label="Delete recipe" t-on-click="() => this.deleteRecipe(recipe)"><i class="fa fa-trash-o"/></button>
                            </span>
                        </div>
                    </t>
                </div>

                <!-- 3. how much did you eat -->
                <div t-if="state.step === 'servings'" class="o_gym_addfood_servings">
                    <div t-if="state.recipe.mine" class="d-flex">
                        <button type="button" class="o_gym_saved_edit" t-on-click="editOpenRecipe">
                            <i class="fa fa-pencil"/> Edit recipe
                        </button>
                    </div>
                    <div class="o_gym_ui_toggle">
                        <button type="button" t-att-class="{ o_active: state.mode === 'g' }"
                                t-on-click="() => this.setMode('g')">Grams</button>
                        <button type="button" t-att-class="{ o_active: state.mode === 's' }"
                                t-on-click="() => this.setMode('s')">Servings</button>
                    </div>
                    <div class="o_gym_ui_label" t-esc="state.mode === 'g' ? 'Grams eaten' : 'Servings eaten'"/>
                    <div class="o_gym_ui_stepper">
                        <button type="button" class="o_gym_ui_step" aria-label="Less"
                                t-on-click="() => state.mode === 'g' ? this.stepGrams(-1) : this.stepServings(-1)"><i class="fa fa-minus"/></button>
                        <input t-if="state.mode === 'g'" type="text" inputmode="decimal" class="o_gym_ui_number"
                               t-att-value="state.grams" t-on-input="onGramsInput"/>
                        <input t-else="" type="text" inputmode="decimal" class="o_gym_ui_number"
                               t-att-value="state.servings" t-on-input="onServingsInput"/>
                        <button type="button" class="o_gym_ui_step" aria-label="More"
                                t-on-click="() => state.mode === 'g' ? this.stepGrams(1) : this.stepServings(1)"><i class="fa fa-plus"/></button>
                    </div>
                    <div class="o_gym_ui_hint">
                        = <b t-esc="equivalent"/> · 1 serving = <t t-esc="fmt(servingWeight)"/> g
                    </div>
                    <div class="o_gym_ui_bignumber"><b t-esc="preview.calories"/> <span>kcal</span></div>
                    <div class="o_gym_ui_legend">
                        <span><i class="o_gym_ui_dot" style="background:#1e88e5"/> Protein <b><t t-esc="preview.protein"/> g</b></span>
                        <span><i class="o_gym_ui_dot" style="background:#f0a30a"/> Carbs <b><t t-esc="preview.carbs"/> g</b></span>
                        <span><i class="o_gym_ui_dot" style="background:#ef7b5d"/> Fat <b><t t-esc="preview.fat"/> g</b></span>
                    </div>
                    <div class="o_gym_ui_hint">
                        <t t-esc="fmt(state.recipe.per_100g.calories)"/> kcal per 100 g of this dish
                    </div>
                    <p t-if="state.recipe.description" class="o_gym_addfood_desc" t-esc="state.recipe.description"/>
                    <button type="button" class="btn btn-primary o_gym_addfood_confirm"
                            t-att-disabled="state.busy or gramsEaten lte 0" t-on-click="confirm">
                        <t t-if="props.entry">Save</t>
                        <t t-else="">Add to <t t-esc="props.mealLabel"/></t>
                    </button>
                </div>
            </div>
        </Dialog>
    </t>

    <!-- ===================== "From Groceries": grams eaten ===================== -->
    <t t-name="family_gym.ProductAmountDialog">
        <Dialog title="title" size="'md'" contentClass="'o_gym_addfood_dialog'" footer="false">
            <div class="o_gym_addfood">
                <div class="o_gym_addfood_servings o_gym_product_amount">
                    <img class="o_gym_product_thumb" alt="" t-att-src="imageUrl()"/>
                    <div class="o_gym_ui_label">Grams eaten</div>
                    <div class="o_gym_ui_stepper">
                        <button type="button" class="o_gym_ui_step" aria-label="Less"
                                t-on-click="() => this.stepGrams(-1)"><i class="fa fa-minus"/></button>
                        <input type="text" inputmode="decimal" class="o_gym_ui_number"
                               t-att-value="state.grams" t-on-input="onGramsInput"/>
                        <button type="button" class="o_gym_ui_step" aria-label="More"
                                t-on-click="() => this.stepGrams(1)"><i class="fa fa-plus"/></button>
                    </div>
                    <div class="o_gym_ui_chips o_gym_product_presets">
                        <button t-foreach="presets" t-as="preset" t-key="preset" type="button" class="o_gym_ui_chip"
                                t-att-class="{ o_active: gramsEaten === preset }"
                                t-on-click="() => this.setGrams(preset)"><t t-esc="preset"/> g</button>
                    </div>
                    <div class="o_gym_ui_bignumber"><b t-esc="preview.calories"/> <span>kcal</span></div>
                    <div class="o_gym_ui_legend">
                        <span><i class="o_gym_ui_dot" style="background:#1e88e5"/> Protein <b><t t-esc="preview.protein"/> g</b></span>
                        <span><i class="o_gym_ui_dot" style="background:#f0a30a"/> Carbs <b><t t-esc="preview.carbs"/> g</b></span>
                        <span><i class="o_gym_ui_dot" style="background:#ef7b5d"/> Fat <b><t t-esc="preview.fat"/> g</b></span>
                    </div>
                    <div class="o_gym_ui_hint">
                        <t t-if="noNutrition"><i class="fa fa-exclamation-triangle"/> No nutrition data for this product in Groceries yet</t>
                        <t t-else=""><t t-esc="fmt(state.product.energy_kcal_100g)"/> kcal per 100 g (from Groceries)</t>
                    </div>
                    <button type="button" class="btn btn-primary o_gym_addfood_confirm"
                            t-att-disabled="state.busy or gramsEaten lte 0" t-on-click="confirm">
                        <t t-if="props.entry">Save</t>
                        <t t-else="">Add to <t t-esc="props.mealLabel"/></t>
                    </button>
                </div>
            </div>
        </Dialog>
    </t>

    <!-- ============================== Restaurants ============================== -->
    <t t-name="family_gym.RestaurantDialog">
        <Dialog title="title" size="'md'" contentClass="'o_gym_addfood_dialog'" footer="false">
            <div class="o_gym_addfood o_gym_rest">

                <button t-if="state.step !== 'list' and !props.entry and !props.itemId" type="button" class="o_gym_addfood_back"
                        t-on-click="back"><i class="fa fa-chevron-left"/> Back</button>

                <!-- 1. the places -->
                <t t-if="state.step === 'list'">
                    <div class="o_gym_rest_grid">
                        <button t-foreach="state.restaurants" t-as="restaurant" t-key="restaurant.id" type="button"
                                class="o_gym_rest_card" t-on-click="() => this.openRestaurant(restaurant)">
                            <img class="o_gym_rest_logo" alt="" t-att-src="logoUrl(restaurant.id)"/>
                            <b t-esc="restaurant.name"/>
                            <span><t t-esc="restaurant.count"/> items</span>
                        </button>
                    </div>
                    <p class="o_gym_rest_disclaimer">
                        Menu of the Polish restaurants. Values are community data (FatSecret) and can differ slightly
                        from the chain's own figures; menu combos are the sum of their parts.
                    </p>
                </t>

                <!-- 2. the menu -->
                <t t-if="state.step === 'menu'">
                    <input type="search" class="o_gym_addfood_search" placeholder="Search the menu..."
                           t-att-value="state.search" t-on-input="onSearchInput"/>
                    <div class="o_gym_ui_chips o_gym_rest_cats">
                        <button t-foreach="state.menu.categories" t-as="cat" t-key="cat.key" type="button" class="o_gym_ui_chip"
                                t-att-class="{ o_active: state.category === cat.key }"
                                t-on-click="() => this.setCategory(cat.key)" t-esc="cat.label"/>
                    </div>
                    <div t-if="!items.length" class="o_gym_addfood_empty">Nothing matches.</div>
                    <button t-foreach="items" t-as="item" t-key="item.id" type="button" class="o_gym_saved_card o_gym_rest_item"
                            t-on-click="() => this.pick(item)">
                        <span class="o_gym_saved_main">
                            <span class="o_gym_saved_name">
                                <t t-esc="item.name"/>
                                <i t-if="item.estimate" class="o_gym_rest_est" title="Estimate">~</i>
                            </span>
                            <span class="o_gym_saved_macros">
                                P <t t-esc="fmt(item.protein)"/> · C <t t-esc="fmt(item.carbs)"/> · F <t t-esc="fmt(item.fat)"/>
                                <t t-if="item.serving_g"> · <t t-esc="fmt(item.serving_g)"/> g</t>
                            </span>
                        </span>
                        <span class="o_gym_rest_kcal"><b t-esc="fmt(item.calories)"/><small>kcal</small></span>
                    </button>
                </t>

                <!-- 3. how many portions -->
                <div t-if="state.step === 'amount'" class="o_gym_addfood_servings">
                    <div class="o_gym_ui_label" t-esc="state.item.restaurant"/>
                    <div class="o_gym_ui_label">Portions eaten</div>
                    <div class="o_gym_ui_stepper">
                        <button type="button" class="o_gym_ui_step" aria-label="Less"
                                t-on-click="() => this.stepServings(-1)"><i class="fa fa-minus"/></button>
                        <input type="text" inputmode="decimal" class="o_gym_ui_number"
                               t-att-value="state.servings" t-on-input="onServingsInput"/>
                        <button type="button" class="o_gym_ui_step" aria-label="More"
                                t-on-click="() => this.stepServings(1)"><i class="fa fa-plus"/></button>
                    </div>
                    <div class="o_gym_ui_chips o_gym_product_presets">
                        <button t-foreach="[0.5, 1, 2, 3]" t-as="preset" t-key="preset" type="button" class="o_gym_ui_chip"
                                t-att-class="{ o_active: servingsEaten === preset }"
                                t-on-click="() => this.setServings(preset)">× <t t-esc="preset"/></button>
                    </div>
                    <div class="o_gym_ui_bignumber"><b t-esc="preview.calories"/> <span>kcal</span></div>
                    <div class="o_gym_ui_legend">
                        <span><i class="o_gym_ui_dot" style="background:#1e88e5"/> Protein <b><t t-esc="preview.protein"/> g</b></span>
                        <span><i class="o_gym_ui_dot" style="background:#f0a30a"/> Carbs <b><t t-esc="preview.carbs"/> g</b></span>
                        <span><i class="o_gym_ui_dot" style="background:#ef7b5d"/> Fat <b><t t-esc="preview.fat"/> g</b></span>
                    </div>
                    <div class="o_gym_ui_hint" t-if="state.item.serving_g">
                        One portion is about <t t-esc="fmt(state.item.serving_g)"/> g<t t-if="servingsEaten !== 1"> · you ate <t t-esc="preview.grams"/> g</t>
                    </div>
                    <div class="o_gym_ui_hint" t-if="state.item.estimate">
                        <i class="fa fa-info-circle"/> Estimate<t t-if="state.item.note">: <t t-esc="state.item.note"/></t>
                    </div>
                    <button type="button" class="btn btn-primary o_gym_addfood_confirm"
                            t-att-disabled="state.busy or servingsEaten lte 0" t-on-click="confirm">
                        <t t-if="props.entry">Save</t>
                        <t t-else="">Add to <t t-esc="props.mealLabel"/></t>
                    </button>
                </div>
            </div>
        </Dialog>
    </t>

</templates>
